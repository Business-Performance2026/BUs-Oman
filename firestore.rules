rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }
    // مالك الشركة أو أحد موظفيها
    function isStaff(companyId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        || (userDoc().companyId == companyId && userDoc().role in ['company','employee'])
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    match /companies/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin()
        || (isStaff(id) && request.resource.data.status == resource.data.status
            && request.resource.data.subscriptionEnd == resource.data.subscriptionEnd
            && request.resource.data.trialEndsAt == resource.data.trialEndsAt
            && request.resource.data.slug == resource.data.slug
            && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin();
    }

    match /trips/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin()
        || isStaff(request.resource.data.companyId)
        || (resource != null && isStaff(resource.data.companyId));
    }

    match /bookings/{id} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin() || isStaff(resource.data.companyId);
      allow delete: if true; // العميل يلغي حجزه برمز التذكرة
    }

    match /employees/{id} {
      allow read: if isAdmin() || isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isAdmin() || isStaff(resource.data.companyId);
    }
  }
}
