rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }
    // مالك الشركة أو أحد موظفيها
    function isStaff(companyId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        || (userDoc().companyId == companyId && userDoc().role in ['company','employee'])
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin()
        || (isStaff(resource.data.companyId)));
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role in ['company','employee']; // لا يمكن لأحد تعيين نفسه admin
      allow update: if isAdmin()
        || (isStaff(resource.data.companyId) && resource.data.role == 'employee'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','whatsapp','perms','active']));
      allow delete: if isAdmin();
    }

    match /companies/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin()
        || (isStaff(id) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name','desc','transferPhone','paymentMethods','logoUrl','coverUrl','buses','crNumber','bankName','contactCall','instagram']));
      allow delete: if isAdmin();
    }

    match /trips/{id} {
      allow read: if true;
      allow create, delete: if isAdmin()
        || isStaff(request.resource.data.companyId)
        || (resource != null && isStaff(resource.data.companyId));
      allow update: if isAdmin()
        || (resource != null && isStaff(resource.data.companyId))
        // العميل: تحديث عداد المقاعد فقط
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked']);
    }

    match /bookings/{id} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin() || isStaff(resource.data.companyId)
        // العميل: إلغاء حجزه فقط (تغيير الحالة إلى ملغي)
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status','cancelReason','cancelledBy','cancelledAt'])
            && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin() || isStaff(resource.data.companyId);
    }

    match /employees/{id} {
      allow read: if isAdmin() || isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isAdmin() || isStaff(resource.data.companyId);
    }
  }
}
