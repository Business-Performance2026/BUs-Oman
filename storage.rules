rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // وصولات التحويل: الرفع للجميع (العميل يرفع وصله)، القراءة للجميع برابط مباشر
    match /receipts/{companyId}/{file} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
